# --- Ambiente e Sistema ---
venv/
env/
.venv/
__pycache__/
*.pyc
.DS_Store
.vscode/
.idea/

# --- DADOS (CRÍTICO: LGPD) ---
# Ignora tudo dentro das pastas de dados...
dados/brutos/*
dados/processados/*
dados/publicos/*

# ...Mas mantém as pastas vazias (graças ao .gitkeep que vamos criar)
!dados/brutos/.gitkeep
!dados/processados/.gitkeep
!dados/publicos/.gitkeep

# --- ARTEFATOS GERADOS ---
# Ignora gráficos, tabelas e logs gerados pelo script
resultados/
resultados_v7/

# --- MODELOS ---
# Modelos pesados não devem ir pro git (são reprodutíveis pelo código)
*.joblib

# --- Outros ---
.ipynb_checkpoints/